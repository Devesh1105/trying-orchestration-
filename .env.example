# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./storage/chroma

# ── 2D Generation ─────────────────────────────────────────────────────────────
# Leave blank to use the default SDXL base model
SDXL_MODEL_ID=

# ── Semantic Tagger ──────────────────────────────────────────────────────────
USE_OLLAMA=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Scene Director (Ollama) ───────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
DIRECTOR_MODEL=llama3:8b

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
MIN_CACHED_ASSETS=3
